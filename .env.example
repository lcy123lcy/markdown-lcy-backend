# Server (前端 3000，后端 3001)
PORT=3001
HOST=0.0.0.0

# Database (SQLite 本地开发示例；生产可改为 postgres)
DATABASE_URL="file:./dev.db"

# JWT (生产环境必须更换 JWT_SECRET 与 REFRESH_SECRET)
JWT_SECRET="dev-secret-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_SECRET="dev-refresh-secret-change-in-production"
REFRESH_EXPIRES_IN="7d"

# 管理员初始密码（seed 时使用，可选）
ADMIN_INIT_PASSWORD="admin123"
